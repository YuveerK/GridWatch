generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Source / ingestion ─────────────

enum SourcePlatform {
  X
}

enum ServiceType {
  ELECTRICITY
  WATER
}

enum SourcePostProcessingStatus {
  UNPROCESSED
  PROCESSING
  RELEVANT
  IRRELEVANT
  GENERAL_NOTICE
  NEEDS_REVIEW
  PROCESSING_ERROR
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

model SourceAccount {
  id             String         @id
  platform       SourcePlatform
  externalId     String         @unique
  displayName    String
  municipalityId String?
  serviceType    ServiceType    @default(ELECTRICITY)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Municipality   Municipality?  @relation(fields: [municipalityId], references: [id])
  IngestionRun   IngestionRun[]
}

model SourcePost {
  id                  String                     @id
  platform            SourcePlatform             @default(X)
  sourceAccount       String
  serviceType         ServiceType                @default(ELECTRICITY)
  externalId          String
  authorId            String?
  conversationId      String?
  text                String
  language            String?
  publishedAt         DateTime
  publicMetrics       Json?
  attachments         Json?
  rawPayload          Json?
  processingStatus    SourcePostProcessingStatus @default(UNPROCESSED)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime
  processingStartedAt DateTime?
  noteTweetText       String?

  IngestionRunPost     IngestionRunPost[]
  PostMedia            PostMedia[]
  extractions          PostExtraction[]
  outagePosts          OutagePost[]
  linkDecisions        LinkDecision[]
  notifications        NotificationEvent[]
  overrides            LinkOverride[]            @relation("OverridePost")
  contrastedBy         LinkOverride[]            @relation("OverrideContrast")
  retries              RetryAttempt[]
  reviewItems          ReviewItem[]
  readingRevisions     ReadingRevision[]
  anchoredBy           LinkOverride[]            @relation("OverrideAnchor")
  summaries            PostSummary[]
  evidence             EvidenceContribution[]
  repairProposals      RepairProposal[]
  autoRepairDirectives AutoRepairDirective[]
  lessonSupports       CorrectionLessonSupport[]
  readingOverride      ReadingOverride?

  @@unique([platform, externalId])
  @@index([processingStatus, publishedAt])
  @@index([sourceAccount, publishedAt(sort: Desc)])
}

model PostMedia {
  id         String     @id
  postId     String
  mediaKey   String
  mediaType  String
  url        String
  width      Int?
  height     Int?
  durationMs Int?
  metadata   Json?
  createdAt  DateTime   @default(now())
  SourcePost SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaKey])
  @@index([postId])
}

model IngestionLease {
  id        String   @id
  owner     String
  expiresAt DateTime
}

model IngestionRun {
  id                String             @id
  sourceAccountId   String
  status            IngestionRunStatus @default(RUNNING)
  checkpointBefore  String?
  checkpointAfter   String?
  pagesFetched      Int                @default(0)
  postsFetched      Int                @default(0)
  postsInserted     Int                @default(0)
  postsDeduplicated Int                @default(0)
  errorCategory     String?
  errorMessage      String?
  diagnostics       Json?
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  SourceAccount     SourceAccount      @relation(fields: [sourceAccountId], references: [id])
  IngestionRunPost  IngestionRunPost[]

  @@index([sourceAccountId, startedAt(sort: Desc)])
}

model IngestionRunPost {
  ingestionRunId String
  postId         String
  createdAt      DateTime     @default(now())
  IngestionRun   IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  SourcePost     SourcePost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([ingestionRunId, postId])
}

// ───────────── Geography (seeded, kept) ─────────────

enum KnowledgeLifecycle {
  CANDIDATE
  CONFIRMED
  DISPUTED
  REJECTED
  RETIRED
}

/// A metro or local municipality (City of Johannesburg, City of Tshwane, ...). Regions are scoped to one
/// of these because each municipality numbers/letters its own official regions independently (Johannesburg
/// uses A-G, Tshwane uses 1-7) - without this, two municipalities reusing a code would collide or, worse,
/// silently corrupt code-keyed lookups elsewhere (geocode sanity-checking, plausibility town lists).
model Municipality {
  id            String          @id
  name          String
  code          String          @unique
  createdAt     DateTime        @default(now())
  Region        Region[]
  SourceAccount SourceAccount[]
  Locality      Locality[]
  InfraNode     InfraNode[]
  Outage        Outage[]
}

model Region {
  id             String       @id
  code           String
  name           String
  municipalityId String
  createdAt      DateTime     @default(now())
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
  Locality       Locality[]

  @@unique([municipalityId, code])
}

model Locality {
  id                  String             @id
  canonicalName       String
  normalizedName      String
  regionId            String?
  /// Which municipality this suburb belongs to. Seeded/GIS-imported rows already carry this via Region -> Municipality; this
  /// column exists so a LEARNED suburb (regionId: null, named by a post but not in the GIS import) still has one, so resolving
  /// it later never falls back to a same-named suburb known to belong to a different, known municipality.
  municipalityId      String?
  sourceLabel         String?
  sourceLine          Int?
  lat                 Float?
  lon                 Float?
  geoSource           String?
  electricitySupplier String?
  /// Simplified GeoJSON Polygon/MultiPolygon (WGS84) from the CoJ CGIS import; null until that's been run for this suburb.
  boundary            Json?
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  Region              Region?            @relation(fields: [regionId], references: [id])
  Municipality        Municipality?      @relation(fields: [municipalityId], references: [id])
  LocalityAlias       LocalityAlias[]
  nodes               NodeLocality[]
  outages             OutageLocality[]
  pushFollowers       PushSubscription[]

  @@unique([regionId, normalizedName])
  @@index([normalizedName])
}

model LocalityAlias {
  id              String             @id
  localityId      String
  alias           String
  normalizedAlias String
  source          String
  confidence      Float?
  status          KnowledgeLifecycle @default(CANDIDATE)
  createdAt       DateTime           @default(now())
  Locality        Locality           @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@unique([localityId, normalizedAlias])
  @@index([normalizedAlias])
}

// ───────────── Extraction (one Gemini call per post) ─────────────

enum Relevance {
  OUTAGE
  PLANNED_OUTAGE
  RESTORATION
  UPDATE
  SDC_SUMMARY
  GENERAL_NOTICE
  IRRELEVANT
}

enum ExtractionStatus {
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

model PostExtraction {
  id            String           @id @default(cuid())
  postId        String
  promptVersion String
  model         String
  status        ExtractionStatus
  relevance     Relevance?
  result        Json?
  imageText     String?
  imageCount    Int              @default(0)
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int?
  error         String?
  createdAt     DateTime         @default(now())
  post          SourcePost       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, promptVersion])
  @@index([status])
}

// ───────────── Learned infrastructure graph ─────────────

enum InfrastructureType {
  SDC
  SUBSTATION
  FEEDER
  DISTRIBUTOR
  TRANSFORMER
  MINI_SUBSTATION
  CABLE
  SWITCHING_STATION
  KIOSK
  LINE
  CIRCUIT
  OTHER
  WATER_SYSTEM
  RESERVOIR
  WATER_TOWER
  PUMP_STATION
  DIRECT_FEED
  BULK_CONNECTION
  BULK_METER
  BOOSTER_STATION
  TREATMENT_WORKS
  PRV
  WATER_PIPELINE
  WATER_OTHER
}

enum InfrastructureRelationType {
  LEGACY_PARENT
  SUPPLIES
  PUMPS_TO
  DIRECTLY_SUPPLIES
  FEEDS
  PART_OF
  UPSTREAM_OF
  BYPASSES
  BACKFEEDS
}

enum NodeLocalityRelationType {
  ASSOCIATED
  SERVES
}

enum KnowledgeSourceType {
  OFFICIAL_WEB
  OFFICIAL_DOCUMENT
  MANUAL_CURATED
}

enum ImpactBasis {
  EXPLICIT_SOURCE
  INFERRED_TOPOLOGY
}

enum WaterOperationalState {
  NORMAL
  STABLE
  CONSTRAINED
  LOW
  CRITICAL
  EMPTY
  NO_INCOMING_SUPPLY
  NO_PUMPING
  PUMPING_REDUCED
  OUTLET_CLOSED
  PARTIAL_SUPPLY
  LOW_PRESSURE
  NO_SUPPLY
  BYPASS
  THROTTLED
  RECOVERING
  UNKNOWN
}

/// Equipment identity is namespaced by municipality: the same station/distributor name in two different tracked utilities is
/// two different nodes unless a post gives explicit evidence they're the same. `municipalityId` is nullable for two reasons:
/// (1) legacy rows from before this column existed, and (2) any caller that resolves a node without knowing the municipality
/// (tests, or code paths with no account context) - those stay in a single, still fully unique, unscoped namespace.
/// NOTE: Postgres does not treat NULL as equal to NULL in a composite unique index, so `@@unique([type, normalizedKey,
/// municipalityId])` alone would silently stop enforcing uniqueness for the municipalityId-null subset. A partial unique
/// index `ON "InfraNode" (type, "normalizedKey") WHERE "municipalityId" IS NULL` (outside Prisma's schema DSL - added by hand
/// in the migration SQL) keeps that subset exactly as strict as it was before this column existed.
model InfraNode {
  id             String             @id @default(cuid())
  type           InfrastructureType
  name           String
  normalizedKey  String
  serviceType    ServiceType        @default(ELECTRICITY)
  municipalityId String?
  metadata       Json?
  lat            Float?
  lon            Float?
  boundary       Json?
  geoSource      String?
  lifecycle      KnowledgeLifecycle @default(CANDIDATE)
  evidenceCount  Int                @default(1)
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  aliases      NodeAlias[]
  parents      InfraEdge[]    @relation("EdgeChild")
  children     InfraEdge[]    @relation("EdgeParent")
  localities   NodeLocality[]
  outages      OutageNode[]
  primaryFor   Outage[]
  Municipality Municipality?  @relation(fields: [municipalityId], references: [id])

  @@unique([serviceType, type, normalizedKey, municipalityId])
  @@index([normalizedKey])
  @@index([serviceType, municipalityId])
}

model NodeAlias {
  id            String    @id @default(cuid())
  nodeId        String
  alias         String
  normalizedKey String
  node          InfraNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, normalizedKey])
  @@index([normalizedKey])
}

// parent supplies/contains child (SDC → substation → distributor → mini-sub …)
model InfraEdge {
  parentId      String
  childId       String
  relationType  InfrastructureRelationType @default(LEGACY_PARENT)
  evidenceCount Int                        @default(1)
  lastSeenAt    DateTime
  parent        InfraNode                  @relation("EdgeParent", fields: [parentId], references: [id], onDelete: Cascade)
  child         InfraNode                  @relation("EdgeChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId, relationType])
  @@index([childId])
}

model NodeLocality {
  nodeId        String
  localityId    String
  relationType  NodeLocalityRelationType @default(ASSOCIATED)
  evidenceCount Int                      @default(1)
  lastSeenAt    DateTime
  node          InfraNode                @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  locality      Locality                 @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@id([nodeId, localityId])
  @@index([localityId])
}

model KnowledgeSource {
  id          String                   @id @default(cuid())
  sourceType  KnowledgeSourceType
  title       String?
  url         String
  publishedAt DateTime?
  fetchedAt   DateTime                 @default(now())
  metadata    Json?
  evidence    InfrastructureEvidence[]

  @@unique([sourceType, url])
}

model InfrastructureEvidence {
  id           String                      @id @default(cuid())
  sourceId     String
  nodeId       String?
  parentId     String?
  childId      String?
  localityId   String?
  relationType InfrastructureRelationType?
  evidenceKind String
  metadata     Json?
  source       KnowledgeSource             @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([sourceId])
}

// ───────────── Outages + linking ─────────────

enum OutageStatus {
  ACTIVE
  PARTIALLY_RESTORED
  RESTORED
  STALE
  CLOSED
  PLANNED
  CANCELLED
}

enum OutageKind {
  UNPLANNED
  PLANNED
}

enum OutagePostRole {
  OPENED
  UPDATE
  RESTORATION
}

enum LinkOutcome {
  LINKED
  NEW
  NEEDS_REVIEW
}

model Outage {
  id                 String                 @id @default(cuid())
  kind               OutageKind             @default(UNPLANNED)
  status             OutageStatus           @default(ACTIVE)
  serviceType        ServiceType            @default(ELECTRICITY)
  waterState         WaterOperationalState?
  title              String
  sdcName            String?
  cause              String?
  etaText            String?
  restorationPercent Int?
  primaryNodeId      String?
  /// Set from the opening post's account at creation. Nullable (legacy rows, or a caller with no account context) - a null
  /// value is never treated as a mismatch, only as "not scoped yet"; see loadCandidates in linker.service.js.
  municipalityId     String?
  retroactive        Boolean                @default(false)
  digest             Boolean                @default(false)
  startedAt          DateTime
  lastUpdateAt       DateTime
  restoredAt         DateTime?
  // announced window for planned work (UTC instants), when the posts gave one
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  primaryNode  InfraNode?       @relation(fields: [primaryNodeId], references: [id])
  Municipality Municipality?    @relation(fields: [municipalityId], references: [id])
  nodes        OutageNode[]
  localities   OutageLocality[]
  posts        OutagePost[]
  decisions    LinkDecision[]

  @@index([status, lastUpdateAt(sort: Desc)])
  @@index([serviceType, status, lastUpdateAt(sort: Desc)])
  @@index([municipalityId, serviceType, lastUpdateAt(sort: Desc)])
}

model OutageNode {
  outageId String
  nodeId   String
  outage   Outage    @relation(fields: [outageId], references: [id], onDelete: Cascade)
  node     InfraNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([outageId, nodeId])
  @@index([nodeId])
}

model OutageLocality {
  outageId    String
  localityId  String
  restored    Boolean     @default(false)
  impactBasis ImpactBasis @default(EXPLICIT_SOURCE)
  outage      Outage      @relation(fields: [outageId], references: [id], onDelete: Cascade)
  locality    Locality    @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@id([outageId, localityId])
  @@index([localityId])
}

model OutagePost {
  outageId   String
  postId     String
  role       OutagePostRole
  score      Float?
  reasons    Json?
  faultIndex Int            @default(0)
  postedAt   DateTime
  // what this fault said about the outage (status inputs, percent, cause, eta, equipment, suburbs); current state is folded from these in time order
  effect     Json?
  outage     Outage         @relation(fields: [outageId], references: [id], onDelete: Cascade)
  post       SourcePost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([outageId, postId, faultIndex])
  @@index([outageId, postedAt])
  @@index([postId])
}

// One-sentence resident-friendly summary of a post (or of one fault inside a multi-fault graphic).
// Kept apart from outage links so it survives replays of the engine.
model PostSummary {
  postId        String
  faultIndex    Int        @default(0)
  summary       String
  model         String
  promptVersion String?
  createdAt     DateTime   @default(now())
  post          SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, faultIndex])
}

model LinkDecision {
  id         String      @id @default(cuid())
  postId     String
  faultIndex Int         @default(0)
  outcome    LinkOutcome
  outageId   String?
  topScore   Float?
  usedLlm    Boolean     @default(false)
  reason     String?
  candidates Json?
  createdAt  DateTime    @default(now())
  post       SourcePost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  outage     Outage?     @relation(fields: [outageId], references: [id], onDelete: SetNull)

  @@unique([postId, faultIndex])
}

/// Cross-process lock. One row per named lock; `expiresAt` is compared with the database clock.
model WorkLease {
  name       String   @id
  owner      String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  renewedAt  DateTime @default(now())
}

/// Where ingestion really is. `completedHighWater` only advances once every page of an interval has been stored;
/// the cursor lets an interrupted run resume where it stopped (and is dropped if X says the token has expired).
model IngestionState {
  accountId          String    @id
  completedHighWater String?
  cursorToken        String?
  cursorSinceId      String?
  cursorNewest       String?
  incomplete         Boolean   @default(false)
  lastCompletedAt    DateTime?
  updatedAt          DateTime  @updatedAt
}

/// One row per (source fault, learned fact). Evidence counters only move when a row is first inserted or removed,
/// so retries and reprocessing can never inflate or double-count what a post taught the graph.
model EvidenceContribution {
  postId     String
  faultIndex Int        @default(0)
  kind       String
  refA       String
  refB       String     @default("")
  createdAt  DateTime   @default(now())
  post       SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, faultIndex, kind, refA, refB])
  @@index([postId])
}

/// A person's correction of where one post (fault) belongs: SPLIT = its own new outage; JOIN = the outage that the anchor post is in.
/// Applied by the linker on every (re)link, so it survives rebuilds. Anchors are posts, never outage ids (those change on a rebuild).
model LinkOverride {
  postId           String
  faultIndex       Int         @default(0)
  action           String
  anchorPostId     String?
  anchorFaultIndex Int         @default(0)
  note             String?
  /// for a SPLIT: a post it must NOT end up in the same outage as (so the correction can be turned into a test)
  contrastPostId   String?
  createdAt        DateTime    @default(now())
  contrast         SourcePost? @relation("OverrideContrast", fields: [contrastPostId], references: [id], onDelete: Cascade)
  post             SourcePost  @relation("OverridePost", fields: [postId], references: [id], onDelete: Cascade)
  anchor           SourcePost? @relation("OverrideAnchor", fields: [anchorPostId], references: [id], onDelete: Cascade)

  @@id([postId, faultIndex])
}

/// A phone that wants push notifications (an Expo push token) and the suburbs it follows.
model PushDevice {
  id            String             @id @default(cuid())
  token         String             @unique
  platform      String?
  /// quiet hours in Johannesburg time (0-23); nothing is sent to this phone between them
  quietFrom     Int?
  quietTo       Int?
  createdAt     DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())
  disabledAt    DateTime?
  subscriptions PushSubscription[]
}

model PushSubscription {
  deviceId   String
  localityId String
  createdAt  DateTime   @default(now())
  device     PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  locality   Locality   @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@id([deviceId, localityId])
  @@index([localityId])
}

/// Every outage change already judged for notifications (sent or not), one row per post fault: a change is announced at most once.
model NotificationEvent {
  postId     String
  faultIndex Int        @default(0)
  outageId   String?
  kind       String
  decision   String
  reason     String?
  recipients Int        @default(0)
  createdAt  DateTime   @default(now())
  post       SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, faultIndex])
  @@index([outageId, createdAt])
}

/// One row per processing cycle: did the work COMPLETE, and exactly which posts/faults, dispositions, readings and outages did it cover?
model CycleQuality {
  id               String   @id @default(cuid())
  trigger          String
  status           String
  startedAt        DateTime
  finishedAt       DateTime @default(now())
  ingestionRunId   String?
  summary          Json
  problems         Json
  posts            Json
  changedOutageIds Json

  @@index([finishedAt])
}

/// A transient failure (a tie-break the AI provider could not answer) that is tried again later, with a bounded number of attempts.
model RetryAttempt {
  postId      String
  faultIndex  Int        @default(0)
  kind        String
  attempts    Int        @default(1)
  lastError   String?
  nextRetryAt DateTime
  createdAt   DateTime   @default(now())
  post        SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, faultIndex, kind])
  @@index([nextRetryAt])
}

/// A change that looks suspicious, queued for a person (and optionally an independent check). Never changes an outage by itself.
model ReviewItem {
  id         String     @id @default(cuid())
  postId     String
  faultIndex Int        @default(0)
  reasons    Json
  priority   Int
  status     String     @default("OPEN")
  sampled    Boolean    @default(false)
  verifier   Json?
  resolution String?
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?
  evidenceFingerprint String?
  post       SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, faultIndex])
  @@index([status, priority])
}

/// Workflow index only. Live diagnostic records remain the source of truth.
model ReviewCase {
  id          String   @id
  subjectKey  String   @unique
  postId      String?
  faultIndex  Int?
  source      String?
  stage       String?
  workflow    String   @default("OPEN")
  fingerprint String
  note        String?
  summary     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  actions     ReviewAction[]

  @@index([workflow, updatedAt])
  @@index([postId])
}

/// One explicit human interpretation; machine extractions are never overwritten.
model ReadingOverride {
  postId          String   @id
  schemaVersion   Int      @default(1)
  serviceType     ServiceType
  sourceHash      String
  baseReadingHash String?
  payload         Json
  evidence        Json
  note            String
  revision        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  post            SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

/// Durable request journal and database snapshot. No browser repair relies on local files.
model ReviewAction {
  id            String   @id @default(cuid())
  caseId        String
  requestId     String   @unique
  type          String
  state         String
  operator      String
  note          String
  evidence      Json
  input         Json
  fingerprint   String
  before        Json?
  after         Json?
  snapshot      Json?
  validation    Json?
  result        Json?
  createdAt     DateTime @default(now())
  finishedAt    DateTime?
  case          ReviewCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@index([state])
}

/// A reading that a later, accepted re-read replaced. Kept so a repair can be undone.
model ReadingRevision {
  id            String     @id @default(cuid())
  postId        String
  promptVersion String
  revision      String?
  model         String?
  result        Json
  replacedAt    DateTime   @default(now())
  post          SourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// One reserved call of the independent verifier (append-only). Reserved before the provider is contacted; counts toward the daily cap.
model VerifierCall {
  id         String   @id @default(cuid())
  day        String
  itemId     String
  postId     String
  reservedAt DateTime @default(now())
  outcome    String?
  error      String?

  @@index([day])
}

// ───────────── Self-correction engine ─────────────
// docs/CLAUDE_SELF_CORRECTING_ENGINE_IMPLEMENTATION.md. Detect a questionable engine decision, propose a specific,
// typed repair, verify it, and (only for allowlisted, gated policies) apply it reversibly under the pipeline lease.
// A RepairProposal never mutates anything by existing; only a RepairAttempt, made under the lease with a snapshot
// first, does. CorrectionLesson is reviewed, reusable knowledge - structured data, never executable instructions.

enum RepairAction {
  REPROCESS_STORED
  JOIN_FAULT
  SPLIT_FAULT
  PROPOSE_READING_REVISION
  PROPOSE_LESSON
}

enum RepairProposalStatus {
  PROPOSED
  SHADOW_EVALUATED
  VERIFYING
  ELIGIBLE
  NEEDS_REVIEW
  REJECTED
  DEFERRED
  APPLYING
  APPLIED
  ROLLED_BACK
  RECOVERY_REQUIRED
  SUPERSEDED
  EXPIRED
}

enum RepairAttemptOutcome {
  APPLIED
  FAILED
  ROLLED_BACK
  RECOVERY_REQUIRED
}

enum LessonKind {
  INCIDENT_CONTINUATION
  INCIDENT_SEPARATION
  EQUIPMENT_ALIAS
  LOCALITY_CONTEXT
  PLANNED_RESCHEDULE
  READING_PATTERN
}

enum LessonStatus {
  CANDIDATE
  REVIEWED
  ACTIVE
  SUSPENDED
  RETIRED
}

/// One detected-and-proposed repair for one (post, fault). Never mutates anything by existing - only an ELIGIBLE
/// proposal's RepairAttempt, made under the pipeline lease, does. `idempotencyKey` is a hash of subject + evidence
/// fingerprint + policy version + action/target, so the same underlying problem can never queue two live proposals.
model RepairProposal {
  id                        String               @id @default(cuid())
  postId                    String
  faultIndex                Int                  @default(0)
  reviewItemId              String?
  serviceType               ServiceType
  municipalityId            String?
  sourceAccount             String
  action                    RepairAction
  generatorName             String
  generatorVersion          String
  policyName                String
  policyVersion             String
  triggerFamily             String
  // fingerprints: does the evidence this proposal was built on still hold?
  sourceContentHash         String
  sourceLayoutHash          String
  lessonSetFingerprint      String
  candidateStateFingerprint String
  // target, expressed by stable anchor post/fault (outage ids are not stable across a rebuild)
  targetAnchorPostId        String?
  targetAnchorFaultIndex    Int?
  observedOutageIds         Json?
  evidence                  Json
  expectedEffect            Json
  affectedManifest          Json
  beforePreview             Json
  afterPreview              Json?
  verification              Json?
  eligibility               Json
  status                    RepairProposalStatus @default(PROPOSED)
  createdAt                 DateTime             @default(now())
  expiresAt                 DateTime
  attemptCount              Int                  @default(0)
  terminalReason            String?
  idempotencyKey            String               @unique

  post      SourcePost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  attempts  RepairAttempt[]
  directive AutoRepairDirective?

  @@index([status, createdAt])
  @@index([postId, faultIndex])
}

/// Append-only account of each application attempt of one proposal. An applied proposal must never exist without
/// a recoverable attempt record - `snapshotRef` names the repair-files.js snapshot taken before the mutation.
model RepairAttempt {
  id                    String               @id @default(cuid())
  proposalId            String
  attemptNumber         Int
  workerOwner           String
  startedAt             DateTime             @default(now())
  endedAt               DateTime?
  inputFingerprint      String
  affectedManifest      Json
  snapshotRef           String?
  snapshotFormatVersion Int                  @default(1)
  snapshotIntegrityHash String?
  beforeSignature       String?
  afterSignature        String?
  operation             String
  validation            Json?
  outcome               RepairAttemptOutcome
  providerReservations  Json?
  errorClass            String?
  recoveryOutcome       String?
  followUpReviewIds     Json?

  proposal RepairProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, attemptNumber])
}

/// Reviewed, reusable knowledge, kept apart from exact-case memory (RepairProposal/AutoRepairDirective). Status only
/// moves CANDIDATE -> REVIEWED -> ACTIVE by an explicit operator action (never automatically); a case this engine
/// itself repaired can supply a CANDIDATE but can never promote it. `claim`/`applicabilityPredicate` are typed JSON,
/// never a prompt blob or executable instructions.
model CorrectionLesson {
  id                      String       @id @default(cuid())
  kind                    LessonKind
  status                  LessonStatus @default(CANDIDATE)
  serviceType             ServiceType
  municipalityId          String?
  sourceAccountScope      String?
  assetTypeScope          Json?
  temporalScope           Json?
  claim                   Json
  applicabilityPredicate  Json
  exclusions              Json?
  counterexamples         Json?
  establishedBy           String
  independentSupportCount Int          @default(1)
  effectiveAt             DateTime     @default(now())
  reviewedAt              DateTime?
  expiresAt               DateTime?
  version                 Int          @default(1)
  supersedesId            String?      @unique
  validationEvidence      Json?
  revocationReason        String?
  createdAt               DateTime     @default(now())

  supports     CorrectionLessonSupport[]
  supersedes   CorrectionLesson?         @relation("LessonSupersession", fields: [supersedesId], references: [id])
  supersededBy CorrectionLesson?         @relation("LessonSupersession")

  @@index([status, serviceType, municipalityId])
}

/// Foreign-keyed, so retiring/deleting a source post is never silently orphaned truth: it must invalidate whatever
/// lesson depended on it. `role` is SUPPORT or CONTRADICT (a stored counterexample, e.g. LinkOverride.contrastPostId).
model CorrectionLessonSupport {
  lessonId   String
  postId     String
  faultIndex Int      @default(0)
  role       String
  createdAt  DateTime @default(now())

  lesson CorrectionLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  post   SourcePost       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([lessonId, postId, faultIndex, role])
}

/// An automatic repair's assignment that must survive relink/reprocess, WITHOUT being mistaken for a person's
/// decision (LinkOverride). Same key shape as LinkOverride ([postId, faultIndex]) so the precedence check in
/// linker.service.js is a symmetric lookup; LinkOverride is always checked first and always wins.
model AutoRepairDirective {
  postId                 String
  faultIndex             Int       @default(0)
  proposalId             String    @unique
  attemptId              String
  /// JOIN or SPLIT - same two actions LinkOverride supports. targetAnchorPostId is required for JOIN, null for SPLIT.
  action                 String
  targetAnchorPostId     String?
  targetAnchorFaultIndex Int?
  policyName             String
  policyVersion          String
  evidenceFingerprint    String
  status                 String    @default("ACTIVE")
  validSince             DateTime  @default(now())
  revalidateAt           DateTime?
  invalidationReason     String?
  createdAt              DateTime  @default(now())

  post     SourcePost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  proposal RepairProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@id([postId, faultIndex])
}

/// Reservation ledger for self-correction's own AI purposes (verify / reread), same pattern as VerifierCall: reserved
/// under one advisory lock before the provider is contacted, counted whether the call succeeds, fails or is interrupted.
model SelfCorrectionCall {
  id         String   @id @default(cuid())
  day        String
  purpose    String
  proposalId String?
  attemptId  String?
  postId     String
  reservedAt DateTime @default(now())
  outcome    String?
  error      String?

  @@index([day])
}
