{
  "name": "gridwatch-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "seed:geography": "node scripts/seed-geography.js",
    "ingest": "node scripts/ingest.js",
    "process": "node scripts/process.js",
    "relink": "node scripts/relink.js",
    "eval": "node scripts/eval.js",
    "geocode": "node scripts/geocode-localities.js",
    "audit": "node scripts/audit.js",
    "reread": "node scripts/reread.js",
    "batch": "node scripts/batch-report.js",
    "quality": "node scripts/quality.js",
    "review": "node scripts/review.js",
    "eval:all": "node scripts/eval-all.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "vitest run && vitest run --config vitest.integration.config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@prisma/client": "6.19",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prisma": "6.19",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
