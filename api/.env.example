# Copy to api/.env and fill in. Never commit api/.env: it holds secrets.

# ── required ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grid-watch
GEMINI_API_KEY=
X_API_BEARER_TOKEN=

# ── operator access (refresh button, /admin routes) ───────
# Fail closed: with none of these set, the refresh button and /admin routes are refused.
# Option 1 (any environment): a long random secret (16+ chars). The refresh button asks for it once and keeps you signed in with a cookie.
#   Scripts can send it as:  Authorization: Bearer <token>
OPERATOR_TOKEN=
OPERATOR_SESSION_HOURS=12
# Option 2 (your own machine only): trust connections from this computer. Ignored in production and for any proxied request.
ALLOW_LOCAL_OPERATOR=off
# Only needed when the client is served from a DIFFERENT origin than the API (the Vite dev proxy does not need it).
# Comma-separated, e.g. https://ops.example.com
CORS_ALLOWED_ORIGINS=

# ── optional (defaults shown) ─────────────────────────────
PORT=4000
X_SOURCE_ACCOUNT_ID=337882328
X_SOURCE_ACCOUNT_NAME=CityPowerJhb
X_INCLUDE_REPLIES=off
X_POLL_INTERVAL_MINUTES=5
X_MAX_PAGES_PER_RUN=20
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=90000
REFRESH_BUTTON=on
REFRESH_COOLDOWN_SECONDS=60
REFRESH_MAX_POSTS=200
MEDIA_MAX_BYTES=10485760
LINK_HIGH_SCORE=0.7
LINK_LOW_SCORE=0.35
OUTAGE_WINDOW_HOURS=72
OUTAGE_AUTOCLOSE_HOURS=48
# SCHEDULER=off   # start the API without the background fetch schedule

# ── self-correction engine (see docs/CLAUDE_SELF_CORRECTING_ENGINE_IMPLEMENTATION.md) ──
# off = no shadow records, no mutation (unchanged behaviour). shadow = proposals are generated and persisted, nothing applied.
# auto = eligible, allowlisted policies may also be applied. Leave "off" until the documented release gates pass.
SELF_CORRECTION_MODE=off
# Comma-separated "policyName@policyVersion" pairs allowed to auto-apply. Empty = nothing may auto-apply.
SELF_CORRECTION_POLICIES=
SELF_CORRECTION_MAX_PROPOSALS_PER_CYCLE=10
SELF_CORRECTION_MAX_APPLIES_PER_CYCLE=2
SELF_CORRECTION_MAX_POSTS_PER_REPAIR=5
SELF_CORRECTION_MAX_OUTAGES_PER_REPAIR=3
SELF_CORRECTION_MAX_AI_CALLS_PER_DAY=30
SELF_CORRECTION_MAX_REREADS_PER_DAY=0
SELF_CORRECTION_MAX_ATTEMPTS=2
SELF_CORRECTION_CYCLE_BUDGET_MS=20000
SELF_CORRECTION_PROPOSAL_TTL_MINUTES=60

# Guided operator review page: inspect and triage while correction writes remain disabled.
# Enable only after migration, queue-coverage comparison, repair/recovery/undo acceptance tests.
REVIEW_CORRECTIONS_ENABLED=off
# Explicit staged rereads only; each request permits at most two extraction calls.
REVIEW_REREAD_MAX_REQUESTS_PER_DAY=10

# Serve the built client from the API (run npm run build in client/ first).
SERVE_WEB_CLIENT=off
# Optional listening interface. Start-GridWatch.cmd binds 127.0.0.1 for local use.
# HOST=127.0.0.1
