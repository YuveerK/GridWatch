# Copy to api/.env and fill in. Never commit api/.env: it holds secrets.

# ── required ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grid-watch
GEMINI_API_KEY=
X_API_BEARER_TOKEN=

# ── operator access (refresh button, /admin routes) ───────
# Fail closed: with none of these set, the refresh button and /admin routes are refused.
# Option 1 (any environment): a long random secret (16+ chars). The refresh button asks for it once and keeps you signed in with a cookie.
#   Scripts can send it as:  Authorization: Bearer <token>
OPERATOR_TOKEN=
OPERATOR_SESSION_HOURS=12
# Option 2 (your own machine only): trust connections from this computer. Ignored in production and for any proxied request.
ALLOW_LOCAL_OPERATOR=off
# Only needed when the client is served from a DIFFERENT origin than the API (the Vite dev proxy does not need it).
# Comma-separated, e.g. https://ops.example.com
CORS_ALLOWED_ORIGINS=

# ── optional (defaults shown) ─────────────────────────────
PORT=4000
X_SOURCE_ACCOUNT_ID=337882328
X_SOURCE_ACCOUNT_NAME=CityPowerJhb
X_INCLUDE_REPLIES=off
X_POLL_INTERVAL_MINUTES=5
X_MAX_PAGES_PER_RUN=20
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=90000
REFRESH_BUTTON=on
REFRESH_COOLDOWN_SECONDS=60
REFRESH_MAX_POSTS=200
MEDIA_MAX_BYTES=10485760
LINK_HIGH_SCORE=0.7
LINK_LOW_SCORE=0.35
OUTAGE_WINDOW_HOURS=72
OUTAGE_AUTOCLOSE_HOURS=48
# SCHEDULER=off   # start the API without the background fetch schedule
